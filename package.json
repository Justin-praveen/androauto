{
  "name": "androauto",
  "version": "0.1.0",
  "description": "Record and replay Android test flows without writing automation code",
  "main": "out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "ui:preview": "vite --config vite.preview.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "appium:driver": "appium driver install uiautomator2"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "fast-xml-parser": "^5.2.0",
    "webdriverio": "^9.20.0",
    "xpath": "^0.0.34"
  },
  "optionalDependencies": {
    "appium": "^3.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^38.0.0",
    "electron-vite": "^5.0.0",
    "lucide-react": "^0.500.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
